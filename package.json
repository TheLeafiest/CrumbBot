{
  "name": "crumbbot",
  "type": "module",
  "version": "1.0.1",
  "description": "Bot for the Crumb Crew",
  "main": "dist/index.js",
  "scripts": {
    "test": "tsc && node --test \"dist/**/*.test.js\"",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "deploy-commands": "node dist/deploy-commands.js",
    "sync-gametest": "tsc && node dist/sync/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheLeafiest/CrumbBot.git"
  },
  "keywords": [
    "crumb",
    "crew",
    "rats",
    "rounds",
    "scoops"
  ],
  "author": "Kale Halter",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/TheLeafiest/CrumbBot/issues"
  },
  "homepage": "https://github.com/TheLeafiest/CrumbBot#readme",
  "dependencies": {
    "discord.js": "^14.27.0",
    "node-schedule": "^2.1.2"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/node-schedule": "^2.1.8",
    "typescript": "^7.0.2"
  }
}
